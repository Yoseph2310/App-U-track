rules_version = '2';

// Reglas de seguridad de U-Track.
// Todos los datos de la app viven en users/{uid}/... (materias, notas y
// actividades). Cada usuario solo puede leer y escribir lo suyo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
